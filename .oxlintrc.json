{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "typescript",
    "oxc"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true,
        "allowExportNames": [
          "useWorkspace",
          "useIncident",
          "actionPermissions",
          "nextAction",
          "navigation"
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "src/components/ui.tsx"
      ],
      "rules": {
        "react/incompatible-library": "off"
      }
    }
  ]
}