AGENTICA_MODE=demo
DATABASE_URL=sqlite:///./data/agentica.db
AGENTICA_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
AGENTICA_DEMO_STEP_SECONDS=1.2
AGENTICA_MAX_UPLOAD_BYTES=2097152
# Azure AI Foundry (Entra sign-in, required for Foundry agents): https://<resource>.services.ai.azure.com/api/projects/<project>
AZURE_AI_PROJECT_ENDPOINT=
AZURE_AI_MODEL_DEPLOYMENT=
AGENTICA_AI_ALLOWED_CLASSIFICATIONS=["Internal"]
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
# Service principal for Foundry agents (alternative to az login). Never commit the secret.
AZURE_CLIENT_SECRET=
AGENTICA_AUTH_AUDIENCE=
OBJECT_STORAGE_CONFIGURATION=
PAYMENT_COMPOSE_PROJECT=behave-payment-sandbox
PAYMENT_API_BIND_ADDRESS=127.0.0.1
PAYMENT_API_PORT=18080
PAYMENT_PREVIOUS_API_PORT=18081
PAYMENT_DB_PORT=15432
PAYMENT_DB_NAME=payments
PAYMENT_DB_USER=payments
PAYMENT_DB_PASSWORD=payment-dev-only
PAYMENT_API_VERSION=3.8.1
PAYMENT_API_IMAGE=behave-payment-api:3.8.1
PAYMENT_DB_POOL_SIZE=5
PAYMENT_DB_MAX_OVERFLOW=0
PAYMENT_DB_POOL_TIMEOUT=2
PAYMENT_DB_HOLD_SECONDS=0.3

# Azure OpenAI (API-key sign-in). Example endpoint: https://<resource>.openai.azure.com/openai/v1; example model: gpt-4.1-mini. Never commit a real key.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# Spend controls for AI calls
AGENTICA_AI_DAILY_CALL_LIMIT=40
AGENTICA_AI_MAX_OUTPUT_TOKENS=900

# Cloud deployment (set by deploy/azure/deploy.sh on the container app; not needed locally)
AGENTICA_SECURE_COOKIES=false
AGENTICA_FOUNDRY_AUTO_SYNC=false
AGENTICA_STATIC_DIR=dist
